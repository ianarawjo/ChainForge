{"flow":{"nodes":[{"width":282,"height":344,"id":"comment-d93a41c7-13c9-4300-a3cd-f2ce69d63199","type":"comment","data":{"title":"Read me first","text":"No API key needed. Both models run in your browser: they download once, about 1.7 GB together, and nothing you type leaves your machine.\n\nThey are tiny, so they make mistakes. That makes them good for practising how to catch mistakes.\n\nFollow the wires: Table, Prompt, Simple Evaluator, Vis."},"position":{"x":-1060,"y":-600},"positionAbsolute":{"x":-1060,"y":-600},"dragHandle":".node-header"},{"width":422,"height":446,"id":"table-e0223721-81cc-498e-8dd3-8084789a61db","type":"table","data":{"title":"Countries","columns":[{"header":"Country","key":"country"},{"header":"Capital","key":"capital"}],"rows":[{"__uid":"25ac6e8e-4d18-4673-9c49-a7ae9f3cdf80","country":"France","capital":"Paris"},{"__uid":"bf8ce264-344a-42a6-8095-2927bd12d5f9","country":"Japan","capital":"Tokyo"},{"__uid":"f9a17e8d-316b-4368-8188-49dc2be96e85","country":"Kenya","capital":"Nairobi"},{"__uid":"cda7da13-025a-403a-b786-0d954e72d520","country":"Australia","capital":"Canberra"},{"__uid":"f54471f5-a8bd-4409-81a4-095d9875e0d0","country":"Canada","capital":"Ottawa"},{"__uid":"08f10385-d912-4cd6-b23a-1917e6129b46","country":"Turkey","capital":"Ankara"},{"__uid":"c3378acc-78b2-4033-b424-e3177b239eac","country":"Switzerland","capital":"Bern"},{"__uid":"9234511c-cd67-4dc8-b460-0f3172d34ccb","country":"New Zealand","capital":"Wellington"},{"__uid":"b5f898b0-6d5c-4fee-8801-d5c73d1248f2","country":"Morocco","capital":"Rabat"},{"__uid":"6eea5290-5dc4-4545-ad4e-b4002bd347d3","country":"Nigeria","capital":"Abuja"},{"__uid":"7ac54956-1471-4d1b-8c22-6ecf26208ebf","country":"Vietnam","capital":"Hanoi"},{"__uid":"fe6a7877-bc17-4450-9371-c8d8b9859243","country":"Pakistan","capital":"Islamabad"}],"sel_rows":null},"position":{"x":-1060,"y":-140},"positionAbsolute":{"x":-1060,"y":-140},"dragHandle":".node-header"},{"width":310,"height":402,"id":"prompt-1b802abc-2f76-